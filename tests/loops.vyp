// Test while loops and counters
void main(void) {
    int i = 0;
    int sum = 0;
    
    print("Counting from 0 to 4:\n");
    while (i < 5) {
        print(i);
        print("\n");
        sum = sum + i;
        i = i + 1;
    }
    
    print("Sum: ");
    print(sum);
    print("\n");
    
    // Nested loop
    int j = 0;
    print("Nested loop:\n");
    while (j < 3) {
        int k = 0;
        while (k < 2) {
            print("j=");
            print(j);
            print(" k=");
            print(k);
            print("\n");
            k = k + 1;
        }
        j = j + 1;
    }
}
